import { assert, assertEq, assertEqString, assertEqBool, fail } from "std:test";
import {
  PasswordPolicy, Pbkdf2Sha256, Argon2id, hashPassword, verifyPassword, needsRehash, verifyAndUpgrade, dummyVerify, parsePhc,
  defaultPasswordPolicy, constantRandom, failingRandom, PasswordRejected, PasswordAccepted, PasswordAcceptedRehashed,
  MalformedHash, UnsupportedAlgorithm, InvalidParams, PasswordTooLong, NoEntropy, MAX_PASSWORD_BYTES,
} from "../src/module";

function fast(i: int): PasswordPolicy {
  return PasswordPolicy { algorithm: Pbkdf2Sha256(i), saltBytes: 16, hashBytes: 32 };
}

@Test
function knownAnswerPhcString(): void {
  // Computed independently with Python's hashlib.pbkdf2_hmac (salt = 16 zero bytes).
  const h = hashPassword("correct horse", fast(10), constantRandom(0)).unwrap();
  assertEqString(h, "$pbkdf2-sha256$i=10$AAAAAAAAAAAAAAAAAAAAAA$9SWleKFvoz90DEeKS7UESclz6baV+Wux/pxXX0RHM9k", "phc");
}

@Test
function verifiesRightAndWrongPasswords(): void {
  const h = hashPassword("correct horse", fast(10), constantRandom(3)).unwrap();
  assertEqBool(verifyPassword("correct horse", h).unwrap(), true, "right");
  assertEqBool(verifyPassword("correct horsf", h).unwrap(), false, "wrong");
  assertEqBool(verifyPassword("", h).unwrap(), false, "empty");
  assertEqBool(verifyPassword("Correct horse", h).unwrap(), false, "case");
}

@Test
function eachHashHasItsOwnSalt(): void {
  // distinct salts come from a distinct random source; constantRandom(1) vs (2)
  const a = hashPassword("pw", fast(2), constantRandom(1)).unwrap();
  const b = hashPassword("pw", fast(2), constantRandom(2)).unwrap();
  assert(a != b, "different salts give different strings");
}

@Test
function verifiesAForeignPbkdf2String(): void {
  const stored = "$pbkdf2-sha256$i=5$BwcHBwcHBwcHBwcHBwcHBw$/SWNqP5yjUHJHQDLpecVd1ymnBM0WFZpsHPHcEbWqx4";
  // (salt = 16 bytes of 0x07) -- a string not produced by this library's own hashPassword in this test run
  assertEqBool(verifyPassword("correct horse", stored).unwrap(), true, "verifies");
  assertEqBool(verifyPassword("correct horsE", stored).unwrap(), false, "rejects");
}

@Test
function malformedStringsAreErrorsNotFalse(): void {
  assert(verifyPassword("x", "plaintext").isErr(), "no $");
  assert(verifyPassword("x", "$pbkdf2-sha256$i=10$AAAA").isErr(), "missing hash");
  assert(verifyPassword("x", "$pbkdf2-sha256$i=10$!!$!!").isErr(), "bad base64");
  assert(verifyPassword("x", "$pbkdf2-sha256$i=0$AAAAAAAAAAAAAAAAAAAAAA$AAAAAAAAAAAAAAAAAAAAAA").isErr(), "zero iterations");
  assert(verifyPassword("x", "$pbkdf2-sha256$i=99999999$AAAAAAAAAAAAAAAAAAAAAA$AAAAAAAAAAAAAAAAAAAAAA").isErr(), "absurd iterations");
  assert(verifyPassword("x", "$pbkdf2-sha256$AAAAAAAAAAAAAAAAAAAAAA$AAAAAAAAAAAAAAAAAAAAAA").isErr(), "no params");
  assert(verifyPassword("x", "$md5$AAAAAAAAAAAAAAAAAAAAAA$AAAAAAAAAAAAAAAAAAAAAA").isErr(), "unknown algorithm");
  const e = verifyPassword("x", "$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0$aGFzaGhhc2hoYXNoaGFzaA").unwrapErr();
  assertEqBool(e.kind == UnsupportedAlgorithm, true, "argon2id is reported as unsupported, not as a wrong password");
}

@Test
function parsesArgon2idPhcStrings(): void {
  const p = parsePhc("$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0$aGFzaGhhc2hoYXNoaGFzaA").unwrap();
  assertEqString(p.id, "argon2id", "id");
  assertEq(p.version.unwrap(), 19, "version");
  assertEq(p.params.length.toInt(), 3, "params");
  assertEq(p.salt.length().toInt(), 12, "salt");
}

@Test
function needsRehashComparesWithThePolicy(): void {
  const h = hashPassword("pw", fast(100), constantRandom(1)).unwrap();
  assertEqBool(needsRehash(h, fast(100)), false, "same");
  assertEqBool(needsRehash(h, fast(50)), false, "stronger than policy");
  assertEqBool(needsRehash(h, fast(101)), true, "weaker than policy");
  assertEqBool(needsRehash(h, PasswordPolicy { algorithm: Pbkdf2Sha256(100), saltBytes: 32, hashBytes: 32 }), true, "shorter salt");
  assertEqBool(needsRehash(h, PasswordPolicy { algorithm: Argon2id(65536, 3, 4), saltBytes: 16, hashBytes: 32 }), true, "other algorithm");
  assertEqBool(needsRehash("garbage", fast(1)), true, "malformed");
  const a = "$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0c2FsdA$aGFzaGhhc2hoYXNoaGFzaGhhc2hoYXNoaGFzaGhhc2g";
  const ap = PasswordPolicy { algorithm: Argon2id(65536, 3, 4), saltBytes: 16, hashBytes: 32 };
  assertEqBool(needsRehash(a, ap), false, "argon2id as strong");
  assertEqBool(needsRehash(a, PasswordPolicy { algorithm: Argon2id(131072, 3, 4), saltBytes: 16, hashBytes: 32 }), true, "less memory");
}

@Test
function verifyAndUpgradeReplacesWeakHashes(): void {
  const weak = hashPassword("pw", fast(2), constantRandom(1)).unwrap();
  const r = verifyAndUpgrade("pw", weak, fast(20), constantRandom(5)).unwrap();
  match (r) {
    PasswordAcceptedRehashed(fresh) => {
      assertEqBool(needsRehash(fresh, fast(20)), false, "new hash meets the policy");
      assertEqBool(verifyPassword("pw", fresh).unwrap(), true, "and still verifies");
    },
    _ => fail("expected a rehash"),
  }
  match (verifyAndUpgrade("pw", weak, fast(2), constantRandom(5)).unwrap()) {
    PasswordAccepted => {},
    _ => fail("expected plain accept"),
  }
  match (verifyAndUpgrade("nope", weak, fast(20), constantRandom(5)).unwrap()) {
    PasswordRejected => {},
    _ => fail("expected reject"),
  }
}

@Test
function aFailedUpgradeNeverRejectsACorrectPassword(): void {
  const weak = hashPassword("pw", fast(2), constantRandom(1)).unwrap();
  match (verifyAndUpgrade("pw", weak, fast(20), failingRandom()).unwrap()) {
    PasswordAccepted => {},
    _ => fail("the login must succeed without an upgrade"),
  }
}

@Test
function refusesBadPoliciesAndLongPasswords(): void {
  assertEqBool(hashPassword("pw", fast(0), constantRandom(1)).unwrapErr().kind == InvalidParams, true, "zero iterations");
  assertEqBool(hashPassword("pw", PasswordPolicy { algorithm: Pbkdf2Sha256(5), saltBytes: 4, hashBytes: 32 }, constantRandom(1)).unwrapErr().kind == InvalidParams, true, "short salt");
  assertEqBool(hashPassword("pw", PasswordPolicy { algorithm: Argon2id(65536, 3, 4), saltBytes: 16, hashBytes: 32 }, constantRandom(1)).unwrapErr().kind == UnsupportedAlgorithm, true, "argon2id deferred");
  assertEqBool(hashPassword("pw", fast(2), failingRandom()).unwrapErr().kind == NoEntropy, true, "no entropy");
  let long = "";
  let i: usize = 0;
  while (i <= MAX_PASSWORD_BYTES) { long = long + "a"; i += 1; }
  assertEqBool(hashPassword(long, fast(2), constantRandom(1)).unwrapErr().kind == PasswordTooLong, true, "too long");
  const h = hashPassword("pw", fast(2), constantRandom(1)).unwrap();
  assertEqBool(verifyPassword(long, h).unwrapErr().kind == PasswordTooLong, true, "verify too long");
}

@Test
function defaultPolicyIsUsable(): void {
  const p = defaultPasswordPolicy();
  assertEq(p.saltBytes.toInt(), 16, "salt");
  assertEq(p.hashBytes.toInt(), 32, "hash");
}

@Test
function dummyVerifyAlwaysFalse(): void {
  assertEqBool(dummyVerify("anything", fast(3)), false, "dummy");
}
