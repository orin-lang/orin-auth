// Helpers shared by the tests.
import { Response } from "orin-web";
import { parseCookieHeader } from "../src/module";

// The value of the cookie `name` set by a response ("" when it sets none).
export function setCookieValueOf(res: Response, name: string): string {
  for (const h of res.headers().getAll("set-cookie")) {
    const first = h.split(";")[0];
    const eq = first.indexOf("=");
    if (eq.isSome() && first.substring(0, eq.unwrap()) == name) {
      return first.substring(eq.unwrap() + 1, first.length);
    }
  }
  return "";
}

// The whole Set-Cookie field of the cookie `name`.
export function setCookieFieldOf(res: Response, name: string): string {
  for (const h of res.headers().getAll("set-cookie")) {
    if (h.startsWith(name + "=")) {
      return h;
    }
  }
  return "";
}

export function hasAttr(field: string, attr: string): bool {
  for (const part of field.split(";")) {
    if (part.trim() == attr) {
      return true;
    }
  }
  return false;
}
