// Password hashing and verification with self-describing PHC strings (https://github.com/P-H-C/phc-string-format), and the
// "upgrade on login" pattern: `needsRehash` says when a stored hash is weaker than the current policy, `verifyAndUpgrade`
// verifies and, when the password was right and the hash is weak, returns the replacement.
//
// Algorithms:
//   Pbkdf2Sha256(iterations)   RFC 8018 PBKDF2-HMAC-SHA-256, PHC id `pbkdf2-sha256`:  $pbkdf2-sha256$i=20000$<salt>$<hash>
//   Argon2id(m, t, p)          the recommended algorithm; needs `std:crypto`. DEFERRED: parsing and policy comparison work,
//                              hashing and verifying return `Err(UnsupportedAlgorithm)` until std:crypto provides argon2id.
// Salt and hash are standard Base64 without padding, as the PHC format says.
//
// The comparison of the derived hash with the stored one is constant-time. A password is limited to 1024 bytes (a longer one is
// refused, not truncated). Passwords are used as the bytes given: no Unicode normalisation is done (std has none yet), so an
// application that wants NFKC must normalise before calling.
import { Bytes, fromString } from "std:bytes";
import * as encoding from "std:encoding";
import { QueryPair } from "std:url";
import { RandomFn } from "./services";
import { AuthError, authErrorMessage } from "./error";
import { pbkdf2HmacSha256, constantTimeEquals, pbkdf2DefaultIterations } from "./internal/crypto";

export type PasswordAlgorithm = Pbkdf2Sha256(int) | Argon2id(int, int, int);

// saltBytes: random salt length (>= 16). hashBytes: derived key length (16 ..= 64).
export type PasswordPolicy = { algorithm: PasswordAlgorithm; saltBytes: usize; hashBytes: usize; };

export type PasswordErrorKind =
  MalformedHash          // not a PHC string, or a field that cannot be decoded
  | UnsupportedAlgorithm // a valid PHC string of an algorithm this build cannot compute (argon2id until std:crypto)
  | InvalidParams        // parameters outside the accepted range (too few iterations for a new hash, absurdly many to verify)
  | PasswordTooLong      // more than 1024 bytes
  | NoEntropy;           // the random source failed; nothing was hashed

export type PasswordError = { kind: PasswordErrorKind; message: string; };

export function passwordErrorMessage(e: PasswordError): string {
  return e.message;
}

function perr(kind: PasswordErrorKind, message: string): PasswordError {
  return PasswordError { kind: kind, message: message };
}

export const MAX_PASSWORD_BYTES: usize = 1024;
// More than this many iterations in a stored hash is refused when verifying (a corrupted or hostile record must not pin a CPU).
const MAX_VERIFY_ITERATIONS: int = 10000000;

// defaultPasswordPolicy(): PasswordPolicy -- PBKDF2-HMAC-SHA-256 with the iteration count the current crypto backend can afford
// (20,000 with the pure-Orin backend; OWASP recommends 600,000, which `std:crypto`'s native implementation will make the
// default), 16 byte salt, 32 byte hash. When the default changes, `needsRehash` returns true for old hashes and
// `verifyAndUpgrade` replaces them at the next successful login.
export function defaultPasswordPolicy(): PasswordPolicy {
  return PasswordPolicy { algorithm: Pbkdf2Sha256(pbkdf2DefaultIterations()), saltBytes: 16, hashBytes: 32 };
}

// A parsed PHC string.
export type Phc = { id: string; version: Option<int>; params: QueryPair[]; salt: Bytes; hash: Bytes; };

function b64(b: Bytes): string {
  return encoding.base64Encode(b, encoding.Unpadded);
}

function paramOf(ps: QueryPair[], key: string): Option<int> {
  for (const p of ps) {
    if (p.key == key) {
      return parseInt(p.value);
    }
  }
  return None;
}

// parsePhc(s): Result<Phc, PasswordError> -- splits `$id[$v=N][$k=v,k=v]$salt$hash`.
export function parsePhc(s: string): Result<Phc, PasswordError> {
  if (!s.startsWith("$") || s.length > 512) {
    return Err(perr(MalformedHash, "not a PHC string"));
  }
  const parts = s.substring(1, s.length).split("$");
  if (parts.length < 3 || parts.length > 5) {
    return Err(perr(MalformedHash, "wrong number of fields"));
  }
  const id = parts[0];
  if (id.length == 0) {
    return Err(perr(MalformedHash, "empty algorithm id"));
  }
  let version: Option<int> = None;
  let at: usize = 1;
  if (parts.length == 5 && parts[1].startsWith("v=")) {
    const v = parseInt(parts[1].substring(2, parts[1].length));
    if (v.isNone()) {
      return Err(perr(MalformedHash, "bad version"));
    }
    version = v;
    at = 2;
  }
  let params: QueryPair[] = [];
  if (parts.length - at == 3) {
    for (const kv of parts[at].split(",")) {
      const eq = kv.indexOf("=");
      if (eq.isNone() || eq.unwrap() == 0) {
        return Err(perr(MalformedHash, "bad parameter"));
      }
      params.push(QueryPair { key: kv.substring(0, eq.unwrap()), value: kv.substring(eq.unwrap() + 1, kv.length) });
    }
    at += 1;
  } else if (parts.length - at != 2) {
    return Err(perr(MalformedHash, "wrong number of fields"));
  }
  const salt = encoding.base64DecodeText(parts[at], encoding.Unpadded);
  const hash = encoding.base64DecodeText(parts[at + 1], encoding.Unpadded);
  if (salt.isErr() || hash.isErr()) {
    return Err(perr(MalformedHash, "salt or hash is not Base64"));
  }
  return Ok(Phc { id: id, version: version, params: params, salt: salt.unwrap(), hash: hash.unwrap() });
}

function checkPolicy(p: PasswordPolicy): Result<void, PasswordError> {
  if (p.saltBytes < 16 || p.saltBytes > 64 || p.hashBytes < 16 || p.hashBytes > 64) {
    return Err(perr(InvalidParams, "salt must be 16..64 bytes and the hash 16..64 bytes"));
  }
  return match (p.algorithm) {
    Pbkdf2Sha256(i) => i >= 1 && i <= MAX_VERIFY_ITERATIONS ? Ok() : Err(perr(InvalidParams, "iterations must be 1..10,000,000")),
    Argon2id(m, t, par) => m >= 8 && t >= 1 && par >= 1 ? Ok() : Err(perr(InvalidParams, "argon2id needs m >= 8, t >= 1, p >= 1")),
  };
}

// hashPassword(password, policy, random): Result<string, PasswordError> -- the PHC string of a new hash with a fresh random salt.
export function hashPassword(password: string, policy: PasswordPolicy, random: RandomFn): Result<string, PasswordError> {
  checkPolicy(policy)?;
  if (password.length > MAX_PASSWORD_BYTES) {
    return Err(perr(PasswordTooLong, "password is longer than 1024 bytes"));
  }
  return match (policy.algorithm) {
    Pbkdf2Sha256(iterations) => {
      const salt = random(policy.saltBytes);
      if (salt.isErr()) {
        return Err(perr(NoEntropy, authErrorMessage(salt.unwrapErr())));
      }
      const dk = pbkdf2HmacSha256(fromString(password), salt.unwrap(), iterations, policy.hashBytes);
      return Ok("$pbkdf2-sha256$i=" + iterations.toString() + "$" + b64(salt.unwrap()) + "$" + b64(dk));
    },
    Argon2id(m, t, par) => Err(perr(UnsupportedAlgorithm, "argon2id needs std:crypto, which is not available yet")),
  };
}

// verifyPassword(password, phc): Result<bool, PasswordError> -- Ok(true) for the right password, Ok(false) for a wrong one; Err when
// the stored string cannot be used (malformed, unsupported algorithm, absurd parameters) or the password is too long.
export function verifyPassword(password: string, phc: string): Result<bool, PasswordError> {
  const h = parsePhc(phc)?;
  if (password.length > MAX_PASSWORD_BYTES) {
    return Err(perr(PasswordTooLong, "password is longer than 1024 bytes"));
  }
  if (h.id == "argon2id") {
    return Err(perr(UnsupportedAlgorithm, "argon2id needs std:crypto, which is not available yet"));
  }
  if (h.id != "pbkdf2-sha256") {
    return Err(perr(UnsupportedAlgorithm, "unknown algorithm " + h.id));
  }
  const iter = paramOf(h.params, "i");
  if (iter.isNone() || iter.unwrap() < 1 || iter.unwrap() > MAX_VERIFY_ITERATIONS) {
    return Err(perr(InvalidParams, "bad iteration count"));
  }
  if (h.salt.length() < 8 || h.salt.length() > 64 || h.hash.length() < 16 || h.hash.length() > 64) {
    return Err(perr(MalformedHash, "salt or hash length out of range"));
  }
  const dk = pbkdf2HmacSha256(fromString(password), h.salt, iter.unwrap(), h.hash.length());
  return Ok(constantTimeEquals(dk, h.hash));
}

// needsRehash(phc, policy): bool -- true when the stored hash is weaker than `policy` or cannot be used: another algorithm, fewer
// iterations / less memory / fewer passes, a shorter salt or hash. A malformed string needs replacing too.
export function needsRehash(phc: string, policy: PasswordPolicy): bool {
  const parsed = parsePhc(phc);
  if (parsed.isErr()) {
    return true;
  }
  const h = parsed.unwrap();
  if (h.salt.length() < policy.saltBytes || h.hash.length() < policy.hashBytes) {
    return true;
  }
  return match (policy.algorithm) {
    Pbkdf2Sha256(want) => {
      if (h.id != "pbkdf2-sha256") {
        return true;
      }
      const have = paramOf(h.params, "i");
      return have.isNone() || have.unwrap() < want;
    },
    Argon2id(m, t, par) => {
      if (h.id != "argon2id") {
        return true;
      }
      const hm = paramOf(h.params, "m");
      const ht = paramOf(h.params, "t");
      const hp = paramOf(h.params, "p");
      return hm.isNone() || ht.isNone() || hp.isNone() || hm.unwrap() < m || ht.unwrap() < t || hp.unwrap() < par;
    },
  };
}

export type VerifyOutcome = PasswordRejected | PasswordAccepted | PasswordAcceptedRehashed(string);

// verifyAndUpgrade(password, phc, policy, random): Result<VerifyOutcome, PasswordError>
//   PasswordRejected              the password is wrong
//   PasswordAccepted              right, and the stored hash is as strong as the policy
//   PasswordAcceptedRehashed(new) right, and the hash was weaker: store `new` instead of the old one
// If rehashing fails (no entropy, an algorithm the build lacks) the login still succeeds as `PasswordAccepted`: a correct password is
// never rejected because the upgrade could not run.
export function verifyAndUpgrade(
  password: string,
  phc: string,
  policy: PasswordPolicy,
  random: RandomFn,
): Result<VerifyOutcome, PasswordError> {
  const ok = verifyPassword(password, phc)?;
  if (!ok) {
    return Ok(PasswordRejected);
  }
  if (!needsRehash(phc, policy)) {
    return Ok(PasswordAccepted);
  }
  const fresh = hashPassword(password, policy, random);
  if (fresh.isErr()) {
    return Ok(PasswordAccepted);
  }
  return Ok(PasswordAcceptedRehashed(fresh.unwrap()));
}

// dummyVerify(password, policy): bool -- spends the time of one verification and answers false. Call it when the user name does
// not exist, so that "no such user" and "wrong password" take alike (an attacker cannot enumerate accounts by timing).
export function dummyVerify(password: string, policy: PasswordPolicy): bool {
  const cost = match (policy.algorithm) {
    Pbkdf2Sha256(i) => i,
    Argon2id(m, t, par) => 1,
  };
  const p = password.length > MAX_PASSWORD_BYTES ? "" : password;
  const dk = pbkdf2HmacSha256(fromString(p), fromString("orin-auth dummy salt"), cost < 1 ? 1 : cost, 32);
  return dk.length() == 0;
}
