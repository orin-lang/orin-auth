// FIPS 180-4 SHA-1, for legacy protocol compatibility only (e.g. Nightscout api-secret).
// New authentication protocols use SHA-256 / HMAC-SHA-256, not SHA-1.
import { Bytes, ByteBuilder } from "std:bytes";

const MASK: int = 4294967295;
function rotate(value: int, bits: int): int {
  return value.shl(bits).bitOr(value.shr(32 - bits)).bitAnd(MASK);
}
export function sha1(input: Bytes): Bytes {
  let padded = new ByteBuilder();
  padded.appendBytes(input);
  padded.appendU8(128.toU8());
  while (padded.length() % 64 != 56) {
    padded.appendU8(0.toU8());
  }
  const bits = input.length().toInt() * 8;
  padded.appendU32Be((bits / 4294967296).toU32());
  padded.appendU32Be((bits % 4294967296).toU32());
  const bytes = padded.build();
  let state = [1732584193, 4023233417, 2562383102, 271733878, 3285377520];
  let block: usize = 0;
  while (block < bytes.length()) {
    let words: int[] = [];
    let i: usize = 0;
    while (i < 16) {
      const at = block + i * 4;
      words.push(
        bytes.at(at).toInt() * 16777216 + bytes.at(at + 1).toInt() * 65536
            + bytes.at(at + 2).toInt() * 256 + bytes.at(at + 3).toInt(),
      );
      i += 1;
    }
    while (i < 80) {
      words.push(
        rotate(words[i - 3].bitXor(words[i - 8]).bitXor(words[i - 14]).bitXor(words[i - 16]), 1),
      );
      i += 1;
    }
    let a = state[0];
    let b = state[1];
    let c = state[2];
    let d = state[3];
    let e = state[4];
    i = 0;
    while (i < 80) {
      const f = i < 20
          ? b.bitAnd(c).bitOr(MASK.bitXor(b).bitAnd(d))
          : i < 40
              ? b.bitXor(c).bitXor(d)
              : i < 60 ? b.bitAnd(c).bitOr(b.bitAnd(d)).bitOr(c.bitAnd(d)) : b.bitXor(c).bitXor(d);
      const k = i < 20 ? 1518500249 : i < 40 ? 1859775393 : i < 60 ? 2400959708 : 3395469782;
      const temp = (rotate(a, 5) + f + e + k + words[i]).bitAnd(MASK);
      e = d;
      d = c;
      c = rotate(b, 30);
      b = a;
      a = temp;
      i += 1;
    }
    const add = [a, b, c, d, e];
    i = 0;
    while (i < 5) {
      state[i] = (state[i] + add[i]).bitAnd(MASK);
      i += 1;
    }
    block += 64;
  }
  let result = new ByteBuilder();
  for (const word of state) {
    result.appendU32Be(word.toU32());
  }
  return result.build();
}
