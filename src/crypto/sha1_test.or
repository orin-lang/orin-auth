import { assertEqString } from "std:test";
import { fromString } from "std:bytes";
import { hexEncode } from "std:encoding";
import { sha1 } from "./sha1";

@Test
function legacyProtocolKnownAnswers(): void {
  assertEqString(
    hexEncode(sha1(fromString(""))),
    "da39a3ee5e6b4b0d3255bfef95601890afd80709",
    "empty",
  );
  assertEqString(
    hexEncode(sha1(fromString("abc"))),
    "a9993e364706816aba3e25717850c26c9cd0d89d",
    "abc",
  );
  assertEqString(
    hexEncode(sha1(fromString("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"))),
    "84983e441c3bd26ebaae4aa1f95129e5e54670f1",
    "two blocks",
  );
}
